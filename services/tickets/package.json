    "seed": "tsx --env-file-if-exists=../../.env src/seed-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@nexo/shared": "*",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": { "@types/better-sqlite3": "^7.6.12" }
}
