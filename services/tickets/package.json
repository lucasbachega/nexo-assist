{
  "name": "@nexo/tickets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serviço de chamados simulado (sistema legado) — HTTP + SQLite",
  "exports": { "./client": "./src/client.ts" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
