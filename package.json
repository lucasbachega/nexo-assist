{
  "name": "nexo-assist",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nexo Assist — agent de atendimento do service desk de TI",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n tickets,web -c magenta,cyan \"npm run dev -w @nexo/tickets\" \"npm run dev -w @nexo/web\"",
    "build": "npm run build -w @nexo/web",
    "start": "concurrently -k -n tickets,web -c magenta,cyan \"npm run start -w @nexo/tickets\" \"npm run start -w @nexo/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "npm run eval -w @nexo/agent",
    "seed": "npm run seed -w @nexo/tickets",
    "reset": "rm -rf data && npm run seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
