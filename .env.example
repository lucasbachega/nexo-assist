# ---------------------------------------------------------------------------
# Nexo Assist — copie para .env e preencha a chave do modelo.
# ---------------------------------------------------------------------------

# Modelo do agent no formato "provedor/modelo" (roteador de modelos do Mastra).
# Padrão: Claude Haiku 4.5 — rápido, barato e bom com ferramentas em português.
MODEL=anthropic/claude-haiku-4-5
ANTHROPIC_API_KEY=
# Para usar OpenAI: MODEL=openai/gpt-5-mini e preencha OPENAI_API_KEY.
OPENAI_API_KEY=

# Serviço de chamados simulado (processo separado).
TICKETS_SERVICE_URL=http://localhost:4000
TICKETS_PORT=4000
# Segredo compartilhado entre o app e o serviço de chamados. Troque em produção.
TICKETS_SERVICE_TOKEN=troque-este-token-local
# Probabilidade de o "legado" responder 503 (0 a 1) e latência máxima simulada.
TICKETS_FLAKY_RATE=0.1
TICKETS_MAX_LATENCY_MS=250

# Pasta dos bancos SQLite (relativa à raiz do projeto).
DATA_DIR=./data

# Limites de uso (proteção de custo).
MAX_MESSAGES_PER_SESSION=30
# Máximo de mensagens ao agent por usuário por hora (todas as sessões).
MAX_MESSAGES_PER_HOUR=60
SESSION_TTL_HOURS=12
